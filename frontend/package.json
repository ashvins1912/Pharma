{
  "name": "quickmeds-rx-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:audit && npm run test:voice-search && npm run test:voice-language && npm run test:medicine-scan && npm run test:api-errors && npm run test:react-error-audit && vite build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "i18n:audit": "node scripts/audit-translations.mjs",
    "test:voice-search": "node --test scripts/voice-search.test.mjs",
    "test:voice-language": "node --test scripts/voice-language.test.mjs",
    "test:medicine-scan": "node --test scripts/medicine-scan.test.mjs",
    "test:api-errors": "node --test scripts/api-error-message.test.mjs",
    "test:react-error-audit": "node --test scripts/react-error-child-audit.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "socket.io-client": "^4.8.1",
    "recharts": "^2.15.0",
    "@pharma/algorithm-kernel": "1.0.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}

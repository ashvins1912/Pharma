# ==============================================================================
# Ashvin Pharmacy — Complete Multi-Tenant API Platform Environment Configuration
# ==============================================================================
# Use this template to create your local .env or configure deployment secrets.
# NEVER commit production credentials or populated .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Server port: Monolith/Express server port (default 3000 in dev, 5000/10000 in prod)
PORT=3000

# Server bind host (use 0.0.0.0 for containerized and cloud environments)
HOST=0.0.0.0

# CORS Allowed Origins: Comma-separated list of exact HTTP(S) browser origins.
# In production, entries MUST use HTTPS. Do NOT use wildcards in production.
# Example: https://pharma.example.com,https://admin.pharma.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://0.0.0.0:3000

# Public URL of the frontend web application
FRONTEND_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. DATABASE & CLUSTER PERSISTENCE
# ------------------------------------------------------------------------------
# MongoDB Connection URI (Optional in dev: fallback in-memory datastore activates)
# In production, provide a replica-set connection string starting with mongodb:// or mongodb+srv://
# Example: mongodb+srv://dbuser:StrongPassword@cluster0.mongodb.net/pharma?retryWrites=true&w=majority
MONGO_URI=

# Confirm replica set supports MongoDB multi-document transactions ('true' or 'false')
# Required to be 'true' before enabling WhatsApp delivery event tracking
MONGO_TRANSACTIONS_CONFIRMED=false


# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & STORAGE INTEGRATION
# ------------------------------------------------------------------------------
# Supabase Project Base URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase Project Identifier (extracted from URL or dashboard)
SUPABASE_PROJECT_ID=

# Supabase Public Anonymous Key (safe for client-side and public API reads)
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (CRITICAL: Server-side only, min 20 characters)
# Used by backend services for administrative user provisioning and privileged operations
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHY, SECRETS & SIGNING KEYS
# ------------------------------------------------------------------------------
# AES-256-GCM 32-byte Encryption Key (Hex or Base64 encoded string)
# Used to encrypt sensitive customer PII and TOTP two-factor secrets at rest
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=

# System Secret Key: Used for signing HMAC tokens, payment action links, and nonces (min 32 chars)
SYSTEM_SECRET_KEY=

# Gateway Authentication Secret: Shared secret between API Gateway and downstream services (min 32 chars)
GATEWAY_AUTH_SECRET=

# Service Authentication Secret: Shared HMAC key for inter-service JWT signing (min 32 chars)
SERVICE_AUTH_SECRET=

# Service JWT Claims
SERVICE_JWT_ISSUER=ashvin-pharmacy
SERVICE_JWT_AUDIENCE=inventory-service
ORDER_SERVICE_JWT_AUDIENCE=order-service

# Delivery Event Secret: Secret for signing and verifying rider action links (min 32 chars)
DELIVERY_EVENT_SECRET=


# ------------------------------------------------------------------------------
# 5. API GATEWAY & PROXY ROUTING
# ------------------------------------------------------------------------------
# Core backend API URL proxied by the standalone API Gateway
BACKEND_API_URL=http://localhost:3000

# Standalone Order microservice URL (optional if using monolith routes)
ORDER_SERVICE_URL=

# Standalone Inventory microservice URL (optional if using monolith routes)
INVENTORY_SERVICE_URL=

# Socket proxy timeout in milliseconds (default: 120000 = 2 minutes)
PROXY_TIMEOUT_MS=120000

# Authentication resolution timeout in milliseconds (default: 15000 = 15 seconds)
AUTH_TIMEOUT_MS=15000

# Gateway Background Service Health Monitor ('true' or 'false')
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MINUTES=15
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_RUN_ON_STARTUP=false


# ------------------------------------------------------------------------------
# 6. STANDALONE ORDER SERVICE (OPTIONAL MICROSERVICE DEPLOYMENT)
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=8091
ORDER_MONGO_URI=
ORDER_DB_NAME=pharma_orders


# ------------------------------------------------------------------------------
# 7. STANDALONE INVENTORY SERVICE & BULK IMPORT ENGINE
# ------------------------------------------------------------------------------
INVENTORY_SERVICE_PORT=8092
INVENTORY_MONGO_URI=
INVENTORY_DB_NAME=pharma_inventory
INVENTORY_CORS_ORIGIN=
INVENTORY_BATCH_SIZE=250
INVENTORY_WORKER_CONCURRENCY=1
INVENTORY_MAX_RETRIES=3

# Bulk import streaming configuration for large catalogs (>5K to 50K+ SKUs)
INVENTORY_IMPORT_BATCH_SIZE=500
INVENTORY_IMPORT_CONCURRENCY=2
INVENTORY_IMPORT_JOB_CONCURRENCY=1
INVENTORY_IMPORT_MAX_FILE_BYTES=104857600
INVENTORY_IMPORT_STORAGE=/var/data/imports


# ------------------------------------------------------------------------------
# 8. DELIVERY & DISPATCH ENGINE
# ------------------------------------------------------------------------------
# Base URL for public signed delivery action pages (rider accept/complete)
# Example: https://pharma.example.com/delivery/action
DELIVERY_ACTION_BASE_URL=http://localhost:3000/delivery/action

# Maximum automated rider assignment retry attempts before flagging manual intervention
DELIVERY_MAX_ATTEMPTS=3

# Optional AWS S3 Storage Driver for prescription uploads (Supabase used by default)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 9. PAYMENT REMINDER ENGINE
# ------------------------------------------------------------------------------
# Enable automated payment reminders for unpaid digital orders ('true' or 'false')
PAYMENT_REMINDER_ENABLED=false
PAYMENT_REMINDER_ENGINE_ENABLED=false

# Throttle duration between successive payment reminder messages in hours (e.g. 24)
PAYMENT_REMINDER_THROTTLE_HOURS=24

# Snooze duration when a customer requests a payment delay in hours (e.g. 48)
PAYMENT_REMINDER_SNOOZE_HOURS=48

# Base URL for customer signed payment action pages
PAYMENT_ACTION_BASE_URL=http://localhost:3000/payment/action


# ------------------------------------------------------------------------------
# 10. WHATSAPP & BAILEYS NOTIFICATION ENGINE
# ------------------------------------------------------------------------------
# Enable WhatsApp notification dispatch ('true' or 'false')
# Requires MONGO_TRANSACTIONS_CONFIRMED=true and valid delivery action secrets
WHATSAPP_DELIVERY_TRACKING_ENABLED=false

# Persistent directory for WhatsApp/Baileys authentication credentials and keys
WHATSAPP_AUTH_DIR=/var/data/whatsapp-auth


# ------------------------------------------------------------------------------
# 11. DEMO & LOCAL DEVELOPMENT PROFILES (DEVELOPMENT / STAGING ONLY)
# ------------------------------------------------------------------------------
# Set to 'false' in production environments
DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_INSTANT_ACCESS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@ashvinpharma.com
DEMO_ADMIN_PASSWORD=DemoAdminPassword123!
DEMO_ADMIN_USER_ID=demo-admin-ashvin-001
DEMO_ADMIN_JWT_SECRET=demo_admin_jwt_secret_key_minimum_32_characters_long_ashvin

DEMO_CUSTOMER_ENABLED=true
DEMO_CUSTOMER_EMAIL=customer@ashvinpharma.com
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_MOBILE=+919876543210
DEMO_CUSTOMER_JWT_SECRET=demo_customer_jwt_secret_key_minimum_32_characters_long


# ------------------------------------------------------------------------------
# 12. CLIENT-SIDE / FRONTEND VITE ENVIRONMENT VARIABLES (`VITE_*`)
# ------------------------------------------------------------------------------
# Base API URL used by the frontend Axios client (defaults to relative /api)
VITE_API_URL=/api

# Client-facing Supabase credentials (must match backend SUPABASE_* configuration)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the deployed frontend
VITE_FRONTEND_URL=http://localhost:3000

# Google Maps API key for address selection and geocoding in checkout
VITE_GOOGLE_MAPS_API_KEY=

# Vite Dev Server API proxy target
VITE_DEV_API_PROXY=http://localhost:3000

# Toggle UI quick-access demo credentials buttons (Disable in production)
VITE_DEMO_ADMIN_ENABLED=true
VITE_DEMO_CUSTOMER_ENABLED=true
VITE_INSTANT_DEMO_ACCESS_ENABLED=true
VITE_DEMO_ADMIN_EMAIL=admin@ashvinpharma.com

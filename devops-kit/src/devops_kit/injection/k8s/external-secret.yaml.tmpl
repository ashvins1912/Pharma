apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ${SERVICE_NAME}-external-secrets
  namespace: ${NAMESPACE}
spec:
  refreshInterval: ${REFRESH_INTERVAL}
  secretStoreRef:
    name: ${SECRET_STORE_NAME}
    kind: ClusterSecretStore
  target:
    name: ${SERVICE_NAME}-runtime-secrets
    creationPolicy: Owner
  data:
${SECRET_DATA_ITEMS}

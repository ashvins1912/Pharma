# Copy these values into Vercel Project Settings > Environment Variables.
# VITE_ variables are embedded in the browser bundle at build time.
VITE_FRONTEND_URL=https://your-project.vercel.app
# Leave empty when the API is deployed as Vercel Functions in this project.
VITE_API_URL=

# Required when using Supabase authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: configure only if the address autocomplete feature is used.
VITE_GOOGLE_MAPS_API_KEY=

# Keep demo access disabled for production deployments.
VITE_DEMO_ADMIN_ENABLED=false
VITE_DEMO_CUSTOMER_ENABLED=false
VITE_INSTANT_DEMO_ACCESS_ENABLED=false

# Configure these server-side variables in Vercel as well. Never prefix
# private values with VITE_.
MONGO_URI=mongodb+srv://your-mongodb-connection-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NODE_ENV=development

# Payment reminder engine remains disabled until payment eligibility and action URL are configured.
PAYMENT_REMINDER_ENGINE_ENABLED=false
PAYMENT_REMINDER_ENABLED=false
PAYMENT_REMINDER_SNOOZE_HOURS=24
PAYMENT_REMINDER_THROTTLE_HOURS=24
PAYMENT_ACTION_BASE_URL=
# Required to issue signed customer actions; use a random secret of at least 32 characters.
SYSTEM_SECRET_KEY=
DELIVERY_EVENT_SECRET=

# Enable delivery callbacks only after verifying replica-set/Atlas transaction support.
WHATSAPP_DELIVERY_TRACKING_ENABLED=false
MONGO_TRANSACTIONS_CONFIRMED=false
DELIVERY_MAX_ATTEMPTS=
DELIVERY_ACTION_BASE_URL=https://api.example.com/api/v1/delivery/events/actions
PORT=8090
MONGO_URI=mongodb://localhost:27017/pharma
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://0.0.0.0:3000
GATEWAY_AUTH_SECRET=
SERVICE_JWT_ISSUER=ashvin-pharmacy
DEMO_ADMIN_ENABLED=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_USER_ID=
DEMO_ADMIN_JWT_SECRET=
DEMO_ADMIN_INSTANT_ACCESS_ENABLED=
DEMO_CUSTOMER_ENABLED=
DEMO_CUSTOMER_JWT_SECRET=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_NAME=
DEMO_CUSTOMER_MOBILE=
ENCRYPTION_SECRET_KEY=
INVENTORY_IMPORT_BATCH_SIZE=1000
INVENTORY_IMPORT_CONCURRENCY=3
INVENTORY_IMPORT_JOB_CONCURRENCY=2
INVENTORY_IMPORT_MAX_FILE_BYTES=104857600

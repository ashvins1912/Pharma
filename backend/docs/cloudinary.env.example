# Cloudinary image delivery (backend only)
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=pharma/catalog

# Optional image validation limits
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=25000000

# Do not expose Cloudinary credentials in frontend environment variables.

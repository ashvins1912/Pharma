# Shared local environment for every Node, Python and UI workspace.
# Copy to env/local.env. Never commit env/local.env or real credentials.
NODE_ENV=development
ENVIRONMENT=development

# Local application endpoints
FRONTEND_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:3000
VITE_API_URL=/api
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_DEV_API_PROXY=http://localhost:8080
VITE_WS_URL=ws://localhost:4000
BACKEND_API_URL=http://localhost:8090
ADMIN_SERVICE_URL=http://localhost:8091
INVENTORY_SERVICE_URL=http://localhost:5100
MEDICINE_MASTER_SERVICE_URL=http://localhost:5101
ORDER_SERVICE_URL=http://localhost:5200
PRESCRIPTION_SERVICE_URL=http://localhost:3002
WEBSOCKET_SERVICE_URL=http://localhost:4000
CACHE_SERVICE_URL=http://localhost:8081

# Shared local ports
PORT=8090
API_GATEWAY_PORT=8080
ADMIN_PORT=8091
INVENTORY_SERVICE_PORT=5100
MEDICINE_MASTER_SERVICE_PORT=5101
ORDER_SERVICE_PORT=5200
PRESCRIPTION_SERVICE_PORT=3002
WS_PORT=4000
CACHE_SERVICE_PORT=8081
SHELL_HOST_PORT=5000
REDIS_PORT=6379
START_LOCAL_REDIS=true
USE_REMOTE_CACHE_SERVICE=false

# Local MongoDB. Keep service databases logically separated.
MONGO_URI=mongodb://127.0.0.1:27017/pharma
ADMIN_MONGO_URI=mongodb://127.0.0.1:27017/pharma_admin
INVENTORY_MONGO_URI=mongodb://127.0.0.1:27017/pharma_inventory
MEDICINE_MASTER_MONGO_URI=mongodb://127.0.0.1:27017/pharma_medicine_master
ORDER_MONGO_URI=mongodb://127.0.0.1:27017/pharma_orders
ADAPTER_MONGO_URI=mongodb://127.0.0.1:27017/pharma_devops
PRESCRIPTION_DB_NAME=pharma_prescriptions
INVENTORY_DB_NAME=pharma_inventory
MEDICINE_MASTER_DB_NAME=pharma_medicine_master
ORDER_DB_NAME=pharma_orders
MONGO_MAX_POOL_SIZE=10

# Local service-to-service authentication. Generate unique values for shared
# development environments; these examples are for isolated local development.
SERVICE_AUTH_SECRET=replace-with-a-random-local-secret-at-least-32-characters
GATEWAY_AUTH_SECRET=replace-with-a-different-random-local-secret-at-least-32-characters
SERVICE_JWT_ISSUER=ashvin-pharmacy
SERVICE_JWT_AUDIENCE=inventory-service
PHARMA_JWT_ISSUER=pharma-auth
PHARMA_JWT_AUDIENCE=pharma-api
# Leave JWT PEM keys empty: workspace.mjs generates an ephemeral local RSA pair.
PHARMA_JWT_PRIVATE_KEY=
PHARMA_JWT_PUBLIC_KEY=

# Optional provider integrations. Keep real credentials out of Git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SYSTEM_SECRET_KEY=

# Optional private DevOps adapter (disabled until configured).
START_PRIVATE_DEVOPS_ADAPTER=false
PRIVATE_DEVOPS_ADAPTER_TOKEN=
PRIVATE_DEVOPS_ADAPTER_URL=

# Runtime defaults
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000
SERVICE_STARTUP_TIMEOUT_MS=60000
LOGGING_ENABLED=true
HEALTH_CHECK_ENABLED=true

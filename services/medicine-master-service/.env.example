# Local development only. Never commit real credentials.
PORT=5101
NODE_ENV=development
MEDICINE_MASTER_MONGO_URI=mongodb://127.0.0.1:27017
MEDICINE_MASTER_DB_NAME=pharma_inventory
# Use a generated random secret (at least 32 bytes), matching API Gateway SERVICE_AUTH_SECRET.
SERVICE_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVICE_JWT_ISSUER=ashvin-pharmacy
MEDICINE_MASTER_SERVICE_JWT_AUDIENCE=medicine-master-service
MEDICINE_MASTER_IMPORT_MAX_FILE_BYTES=115343360
LOGGING_ENABLED=true
